# Free AI (pick one):

# 1) Google AI Studio — free key, usually no credit card
#    https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# 2) Vercel AI Gateway free models — on Vercel deployments, OIDC works
#    but the team must have a card on file (free-model usage stays $0)
# AI_GATEWAY_API_KEY=
# AI_MODEL=nvidia/nemotron-3.5-lightning-free

# PayPal sandbox (optional — demo invoice/payout without these)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
